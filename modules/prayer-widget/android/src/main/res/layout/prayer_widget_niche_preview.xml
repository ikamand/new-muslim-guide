<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker shows (docs/widgets.md). The widget itself draws its
  arch from the schedule, and the picker runs before the app has ever stored
  one, so there is nothing true to draw: this says what the widget is instead
  of inventing a prayer time. Both words are checked against src/i18n/ui.ts.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/prayer_widget_ground"
  android:clipToOutline="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/literata_semibold"
      android:gravity="center"
      android:maxLines="2"
      android:text="@string/prayer_widget_name_niche"
      android:textColor="@color/prayer_widget_text"
      android:textSize="16sp" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center"
      android:maxLines="2"
      android:text="@string/prayer_widget_niche_description"
      android:textColor="@color/prayer_widget_text_secondary"
      android:textSize="11sp" />
  </LinearLayout>
</FrameLayout>
