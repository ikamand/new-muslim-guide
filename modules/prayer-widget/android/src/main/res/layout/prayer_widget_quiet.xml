<?xml version="1.0" encoding="utf-8"?>
<!--
  The quiet one (docs/widgets.md): a day mark and a time, no prayer name and
  no app name, for a phone that gets picked up by family who have not been told.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/prayer_widget_ground"
  android:clipToOutline="true"
  android:gravity="center"
  android:orientation="horizontal"
  android:paddingStart="14dp"
  android:paddingEnd="14dp">

  <ImageView
    android:id="@+id/prayer_widget_mark"
    android:layout_width="22dp"
    android:layout_height="22dp"
    android:layout_marginEnd="10dp"
    android:importantForAccessibility="no" />

  <TextView
    android:id="@+id/prayer_widget_time"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFeatureSettings="tnum"
    android:maxLines="1"
    android:textColor="@color/prayer_widget_text"
    android:textSize="15sp" />

  <TextView
    android:id="@+id/prayer_widget_message"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:maxLines="2"
    android:textColor="@color/prayer_widget_text_secondary"
    android:textSize="11sp"
    android:visibility="gone" />
</LinearLayout>
