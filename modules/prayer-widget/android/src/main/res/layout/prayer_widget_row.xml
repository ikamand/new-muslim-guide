<?xml version="1.0" encoding="utf-8"?>
<!--
  The row (docs/widgets.md): one line above a gold rule, and the Today card's
  five cells. Everything that changes is set from the schedule at every redraw.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/prayer_widget_ground"
  android:clipToOutline="true"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingTop="12dp"
  android:paddingEnd="12dp"
  android:paddingBottom="8dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <TextView
      android:id="@+id/prayer_widget_caption"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="8dp"
      android:letterSpacing="0.12"
      android:maxLines="1"
      android:textAllCaps="true"
      android:textColor="@color/prayer_widget_text_secondary"
      android:textSize="9sp" />

    <TextView
      android:id="@+id/prayer_widget_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="8dp"
      android:fontFamily="@font/literata_semibold"
      android:maxLines="1"
      android:text="@string/prayer_widget_name_row"
      android:textColor="@color/prayer_widget_text"
      android:textSize="17sp" />

    <TextView
      android:id="@+id/prayer_widget_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:textColor="@color/prayer_widget_gold"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>

  <FrameLayout
    android:id="@+id/prayer_widget_rule"
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="@color/prayer_widget_gold_soft" />

  <TextView
    android:id="@+id/prayer_widget_message"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:maxLines="2"
    android:paddingTop="12dp"
    android:textColor="@color/prayer_widget_text_secondary"
    android:textSize="12sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/prayer_widget_cells"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="6dp">

    <LinearLayout
      android:id="@+id/prayer_widget_cell_fajr"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:clipToOutline="true"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">
      <ImageView
        android:id="@+id/prayer_widget_mark_fajr"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no" />
      <TextView
        android:id="@+id/prayer_widget_label_fajr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/prayer_widget_time_fajr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/prayer_widget_cell_dhuhr"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:clipToOutline="true"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">
      <ImageView
        android:id="@+id/prayer_widget_mark_dhuhr"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no" />
      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- Friday: the card's dot, a condition stated rather than a relabelling. -->
        <FrameLayout
          android:id="@+id/prayer_widget_friday"
          android:layout_width="5dp"
          android:layout_height="5dp"
          android:layout_marginEnd="3dp"
          android:clipToOutline="true"
          android:visibility="gone" />
        <TextView
          android:id="@+id/prayer_widget_label_dhuhr"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textSize="11sp" />
      </LinearLayout>
      <TextView
        android:id="@+id/prayer_widget_time_dhuhr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/prayer_widget_cell_asr"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:clipToOutline="true"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">
      <ImageView
        android:id="@+id/prayer_widget_mark_asr"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no" />
      <TextView
        android:id="@+id/prayer_widget_label_asr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/prayer_widget_time_asr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/prayer_widget_cell_maghrib"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:clipToOutline="true"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">
      <ImageView
        android:id="@+id/prayer_widget_mark_maghrib"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no" />
      <TextView
        android:id="@+id/prayer_widget_label_maghrib"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/prayer_widget_time_maghrib"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/prayer_widget_cell_isha"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:clipToOutline="true"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">
      <ImageView
        android:id="@+id/prayer_widget_mark_isha"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no" />
      <TextView
        android:id="@+id/prayer_widget_label_isha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:textSize="11sp" />
      <TextView
        android:id="@+id/prayer_widget_time_isha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
