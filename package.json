  "scripts": {
    "start": "expo start",
    "update:preview": "eas update --branch preview --environment preview --message \"$(git log -1 --pretty=%s)\"",
    "update:production": "eas update --branch production --environment production --message \"$(git log -1 --pretty=%s)\"",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "arabic": "node --import ./scripts/ts-resolve.mjs scripts/arabic-proof.mjs",
    "icons": "node scripts/make-icons.mjs",
    "audio:manifest": "node --import ./scripts/ts-resolve.mjs scripts/audio-manifest.mjs",
    "audio:brief": "node scripts/audio-brief.mjs",
    "i18n:manifest": "node --import ./scripts/ts-resolve.mjs scripts/i18n-manifest.mjs",
    "content:audit": "node --import ./scripts/ts-resolve.mjs scripts/content-audit.mjs",
    "content:verify": "node --import ./scripts/ts-resolve.mjs scripts/content-verify.mjs",
    "quran:juz30": "node scripts/generate-juz30.mjs",
    "evidence": "node --import ./scripts/ts-resolve.mjs scripts/generate-evidence.mjs",
    "hisn": "node scripts/generate-hisn.mjs",
    "style:check": "node --import ./scripts/ts-resolve.mjs scripts/teaching-check.mjs",
    "search:check": "node --import ./scripts/ts-resolve.mjs scripts/search-check.mjs",
    "hadith:corpus": "node --import ./scripts/ts-resolve.mjs scripts/fetch-hadith-corpus.mjs",
