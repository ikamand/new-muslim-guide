    "align:check": "node --import ./scripts/ts-resolve.mjs scripts/align-check.mjs",
    "narration:check": "node --import ./scripts/ts-resolve.mjs scripts/narration-check.mjs",
    "plan:check": "node --import ./scripts/ts-resolve.mjs scripts/plan-check.mjs",
    "verify:import": "node --import ./scripts/ts-resolve.mjs scripts/verify-import.mjs",
    "collection:names": "node scripts/generate-names.mjs",
    "collection:duas": "node scripts/generate-quranic-duas.mjs",
    "zakat:nisab": "node scripts/fetch-nisab.mjs",
    "nav:check": "node scripts/navigation-check.mjs"
