  "scripts": {
    "start": "expo start",
    "update:preview": "eas update --branch preview --environment preview --message \"$(git log -1 --pretty=%s)\"",
    "update:production": "eas update --branch production --environment production --message \"$(git log -1 --pretty=%s)\"",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "arabic": "node --import ./scripts/ts-resolve.mjs scripts/arabic-proof.mjs",
    "icons": "node scripts/make-icons.mjs",
    "audio:manifest": "node scripts/audio-manifest.mjs",
    "i18n:manifest": "node --import ./scripts/ts-resolve.mjs scripts/i18n-manifest.mjs"
